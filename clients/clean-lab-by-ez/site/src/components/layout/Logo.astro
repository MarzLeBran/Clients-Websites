---
// The one canonical brand lockup — Header and Footer both render this
// component so the asset stack (icon + two-tone wordmark + "by EZ" script)
// and its treatment can never drift apart. The artwork is decorative
// (aria-hidden / empty alt); the accessible name comes from the parent — a
// link aria-label in the header, a role="img" label in the footer.
import { Image } from 'astro:assets';
import logoMark from '../../assets/logo/logo-mark.png';
import byEzMark from '../../assets/logo/by-ez.png';
---

<span class="flex items-center gap-2">
  <Image src={logoMark} alt="" width={44} height={36} class="h-9 w-auto" />
  <span class="flex items-baseline gap-1.5" aria-hidden="true">
    <span class="font-display text-display-sm font-bold uppercase tracking-tight">
      <span class="text-text-primary">Clean </span><span class="text-brand-primary">Lab</span>
    </span>
    <Image src={byEzMark} alt="" width={70} height={14} class="h-4 w-auto translate-y-0.5" />
  </span>
</span>
