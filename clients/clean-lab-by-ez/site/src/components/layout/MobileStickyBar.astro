---
// Non-negotiable per build-standards: thumb-reachable Call / Book / Text bar,
// visible only on small screens.
import { site } from '../../config/site.config';
import { telHref, smsHref } from '../../lib/format';

const phone = site.business.phoneE164 || site.business.phone;
const canText = site.business.sms;
---

{/* pb-[env(...)] keeps the tap targets above the iPhone home indicator;
    BaseLayout's body padding uses the same calc so content never hides
    under the bar. */}
<div class="fixed inset-x-0 bottom-0 z-40 flex min-h-14 border-t border-border bg-surface pb-[env(safe-area-inset-bottom)] md:hidden">
  {phone && (
    <a href={telHref(phone)} class="flex flex-1 items-center justify-center gap-2 text-body font-medium">
      Call
    </a>
  )}
  <a href="/contact/" class="flex flex-1 items-center justify-center gap-2 border-x border-border text-body font-medium">
    Book
  </a>
  {canText && phone && (
    <a href={smsHref(phone)} class="flex flex-1 items-center justify-center gap-2 text-body font-medium">
      Text
    </a>
  )}
</div>
