---
import { site } from '../../config/site.config';
import { formatPhone, formatHours, telHref } from '../../lib/format';
import CoquiMark from '../ui/CoquiMark.astro';

const socialLinks = Object.entries(site.social).filter(([, url]) => url);
const year = new Date().getFullYear();
---

<footer class="bg-neutral-900 text-neutral-50 px-6 py-14">
  <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[auto_1fr_auto] md:items-start">
    <CoquiMark class="h-16 w-16 flex-shrink-0 text-brand-primary" aria-hidden={false} />

    <div class="font-display italic">
      <p class="text-display-sm">{site.business.tagline}.</p>
      {site.business.taglineSecondary && (
        <p class="mt-1 text-body text-text-muted">{site.business.taglineSecondary}.</p>
      )}
    </div>

    <div class="grid gap-8 sm:grid-cols-2 md:text-right">
      <div>
        {site.business.phone && (
          <a href={telHref(site.business.phoneE164 || site.business.phone)} class="block text-body font-medium">
            {formatPhone(site.business.phoneE164 || site.business.phone)}
          </a>
        )}
        {site.business.email && <a href={`mailto:${site.business.email}`} class="block text-body">{site.business.email}</a>}
        {site.serviceAreaLabel && <p class="mt-1 text-utility text-text-muted">Serving {site.serviceAreaLabel}</p>}
        {site.business.hours.length > 0 && (
          <ul class="mt-2 text-utility text-text-muted">
            {formatHours(site.business.hours).map((line) => <li>{line}</li>)}
          </ul>
        )}
      </div>
      <div>
        <nav aria-label="Legal">
          <ul class="flex flex-col gap-1 md:items-end">
            <li><a href="/privacy/" class="text-utility">Privacy Policy</a></li>
            <li><a href="/terms/" class="text-utility">Terms of Service</a></li>
          </ul>
        </nav>
        {socialLinks.length > 0 && (
          <nav aria-label="Social" class="mt-4">
            <ul class="flex gap-4 md:justify-end">
              {socialLinks.map(([name, url]) => (
                <li><a href={url} class="text-utility capitalize" aria-label={name}>{name}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>
  </div>
  <div class="mx-auto mt-10 max-w-6xl border-t border-line pt-6">
    <p class="text-utility text-text-muted">&copy; {year} {site.business.legalName}. All rights reserved.</p>
  </div>
</footer>
