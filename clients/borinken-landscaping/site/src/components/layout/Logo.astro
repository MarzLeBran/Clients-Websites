---
// The one canonical brand lockup — Header and Footer both render this
// component so the mark and its treatment can never drift apart.
import CoquiMark from '../ui/CoquiMark.astro';
import { site } from '../../config/site.config';

interface Props {
  markOnly?: boolean;
  class?: string;
}

const { markOnly = false, class: className = '' } = Astro.props;
---

{markOnly ? (
  <CoquiMark class={`h-9 w-9 ${className}`} aria-hidden={false} />
) : (
  <span class={`inline-flex items-center gap-2.5 ${className}`}>
    <CoquiMark class="h-8 w-8 flex-shrink-0" aria-hidden={false} />
    <span class="font-display text-display-sm font-semibold">{site.business.displayName}</span>
  </span>
)}
