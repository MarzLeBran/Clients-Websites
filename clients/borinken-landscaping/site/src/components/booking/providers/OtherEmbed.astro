---
// Generic iframe wrapper for providers without a dedicated component
// (e.g. Housecall Pro, ServiceTitan).
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<div class="other-embed aspect-[4/5] w-full overflow-hidden rounded-card">
  <iframe src={url} title="Book an appointment" class="h-full w-full" loading="lazy"></iframe>
</div>
