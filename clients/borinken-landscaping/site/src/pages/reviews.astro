---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ReviewCard from '../components/ui/ReviewCard.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import BreadcrumbListSchema from '../components/schema/BreadcrumbListSchema.astro';
import { site } from '../config/site.config';
import { getCollection } from 'astro:content';

const testimonials = await getCollection('testimonials');
---

<BaseLayout
  title={`Reviews | ${site.business.displayName}`}
  description="5.0 stars on Google, 22 reviews. Read what Brevard County customers say."
>
  <BreadcrumbListSchema
    slot="head"
    crumbs={[
      { name: 'Home', url: Astro.site?.toString() ?? '/' },
      { name: 'Reviews', url: new URL('/reviews/', Astro.site).toString() },
    ]}
  />
  <section class="px-6 py-16 md:py-20">
    <div class="mx-auto max-w-5xl">
      <div class="mb-10 flex flex-wrap items-baseline justify-between gap-3">
        <SectionHeading eyebrow="Reviews" title="What customers say" />
        <p class="flex items-center gap-2 text-body text-text-muted">
          <span class="text-brand-primary" aria-hidden="true">★★★★★</span>
          <span class="font-utility font-medium">5.0 — 22 reviews on Google</span>
        </p>
      </div>

      {testimonials.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {testimonials.map((t) => (
            <ReviewCard
              author={t.data.author}
              rating={t.data.rating}
              quote={t.data.quote}
              service={t.data.service}
              ownerReply={t.data.ownerReply}
            />
          ))}
        </div>
      ) : (
        <p class="text-body">No reviews loaded yet.</p>
      )}

      <p class="mt-10 text-utility text-text-muted">
        These are the reviews we've pulled directly from Google so far — the full 22-review, 5.0-star
        record is real and verified on Borinken Landscaping's Google Business Profile.
      </p>

      <div class="mt-12 text-center">
        <CTAButton href="/contact/" sweep>Get a free estimate</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
