---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import CTAButton from '../../components/ui/CTAButton.astro';
import BreadcrumbListSchema from '../../components/schema/BreadcrumbListSchema.astro';
import { site } from '../../config/site.config';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const pageServices = services.filter((s) => s.data.serviceTier !== 'addon');
const addons = services.filter((s) => s.data.serviceTier === 'addon');
const url = new URL('/services/', Astro.site).toString();
---

<BaseLayout
  title={`Lawn Care & Landscaping Services | ${site.business.displayName}`}
  description={`Mowing, weed eating, planting, and edging — landscaping services from ${site.business.displayName}, serving ${site.serviceAreaLabel}.`}
>
  <BreadcrumbListSchema slot="head" crumbs={[{ name: 'Home', url: Astro.site?.toString() ?? '/' }, { name: 'Services', url }]} />
  <section class="px-6 py-16 md:py-20">
    <div class="mx-auto max-w-5xl">
      <SectionHeading eyebrow="Services" title="What we do" />
      <div class="grid gap-6 md:grid-cols-2">
        {pageServices.map((s) => (
          <ServiceCard name={s.data.name} slug={s.data.slug} shortDescription={s.data.shortDescription} priceFrom={s.data.priceFrom} />
        ))}
      </div>

      {addons.length > 0 && (
        <div id="add-ons" class="mt-16">
          {/* Add-ons are cards here, never standalone pages — no thin URLs. */}
          <SectionHeading eyebrow="Add-Ons" title="Add-on services" level="h2" />
          <div class="grid gap-6 md:grid-cols-3">
            {addons.map((s) => (
              <div class="rounded-card border border-line bg-surface-alt p-6 shadow-card">
                <h3 class="font-display text-display-md font-bold">{s.data.name}</h3>
                <p class="mt-2 text-body">{s.data.shortDescription}</p>
                {s.data.priceFrom && <p class="mt-4 text-utility">From ${s.data.priceFrom}</p>}
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="mt-16 text-center">
        <CTAButton href="/contact/" sweep>Get a free estimate</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
